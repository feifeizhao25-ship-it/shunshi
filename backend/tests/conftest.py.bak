# tests/conftest.py — 测试环境配置
import os
import sys

# 设置测试环境变量
os.environ.setdefault("APP_ENV", "testing")
os.environ.setdefault("JWT_SECRET", "test-jwt-secret-for-testing-only")
os.environ.setdefault("DATABASE_URL", "sqlite:///./test_shunshi.db")
os.environ.setdefault("APP_DEBUG", "true")

# 确保测试 DB 路径（强制使用绝对路径，避免 SQLAlchemy ORM 和原生 sqlite3 指向不同文件）
_db_path = os.path.abspath(os.path.join(os.path.dirname(__file__), "test_shunshi.db"))
os.environ["DATABASE_URL"] = f"sqlite:///{_db_path}"
print(f"[TEST] DATABASE_URL set to: {os.environ['DATABASE_URL']}")

import pytest
from fastapi.testclient import TestClient


@pytest.fixture(scope="session")
def app():
    """创建测试用 FastAPI 应用实例"""
    from app.main import app as _app
    return _app


@pytest.fixture(scope="session", autouse=True)
def setup_test_db():
    """Session级：创建测试数据库表"""
    from app.models.base import Base as ModelBase
    from app.db.database import Base as DBBase, engine
    from app.database.db import init_db as sqlite_init_db, get_db
    # 先创建原生 sqlite3 表（包括 users 等旧表结构）
    sqlite_init_db()
    # 关闭所有原生 sqlite3 连接，避免与 SQLAlchemy 冲突
    from app.database.db import close_all_test_connections
    close_all_test_connections()
    # 重置 SQLAlchemy 连接池，避免连接间锁定
    engine.dispose()
    # 将旧基类的表合并到新 metadata，使新模型外键能解析
    for table_name, table in list(DBBase.metadata.tables.items()):
        if table_name not in ModelBase.metadata.tables:
            table.to_metadata(ModelBase.metadata)
    from sqlalchemy import text
    with engine.connect() as conn:
        conn.execute(text("PRAGMA foreign_keys=OFF"))
        ModelBase.metadata.create_all(bind=conn)
        conn.execute(text("PRAGMA foreign_keys=ON"))
        conn.commit()
    # 插入通用测试用户，避免外键约束失败
    db = get_db()
    now = __import__('datetime').datetime.now().isoformat()
    test_users = [
        ("user-001", "测试用户001", "user001@test.com"),
        ("user-002", "测试用户002", "user002@test.com"),
        ("test-user-001", "测试用户", "test001@test.com"),
        ("test-user-002", "测试用户2", "test002@test.com"),
        ("care-test-user", "关怀测试用户", "care@test.com"),
        ("test-user-preference", "测试用户", "pref@test.com"),
        ("test-user-habit", "测试用户", "habit@test.com"),
        ("test-user-emotional_trend", "测试用户", "emotional@test.com"),
        ("test-user-reflection_theme", "测试用户", "reflection@test.com"),
        ("test-user-context", "测试用户", "context@test.com"),
        ("delete-test-user", "删除测试用户", "delete@test.com"),
        ("context-test-user", "上下文测试用户", "context2@test.com"),
        ("due-test-user", "到期测试用户", "due@test.com"),
        ("complete-test-user", "完成测试用户", "complete@test.com"),
        ("cancel-test-user", "取消测试用户", "cancel@test.com"),
    ]
    # Debug: check users table schema
    cursor = db.execute("PRAGMA table_info(users)")
    cols = [r[1] for r in cursor.fetchall()]
    print(f"[DEBUG] users columns: {cols}")
    for uid, name, email in test_users:
        db.execute(
            "INSERT OR IGNORE INTO users (id, name, email, password_hash, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)",
            (uid, name, email, "test_hash", now, now)
        )
    db.commit()
    yield
    # 清理：删除测试DB
    import os
    db_path = os.path.join(os.path.dirname(__file__), "test_shunshi.db")
    if os.path.exists(db_path):
        try:
            os.remove(db_path)
        except Exception:
            pass


@pytest.fixture(scope="function")
def client(app):
    """HTTP 测试客户端"""
    with TestClient(app) as c:
        yield c


@pytest.fixture(scope="function", autouse=True)
def cleanup_test_db():
    """每个测试开始前清理数据并关闭连接，避免数据累积和 database locked"""
    from app.database.db import get_db, close_all_test_connections
    db = get_db()
    # 清理可能累积测试数据的表（保留 users 等基础表）
    tables_to_truncate = [
        # SQLAlchemy ORM 表
        "sa_journal_entries", "sa_journal_photos",
        "sa_chat_messages", "sa_chat_conversations", "sa_chat_memories",
        "sa_exercise_logs", "sa_exercise_favorites",
        "sa_recipe_favorites", "sa_tea_favorites",
        "sa_constitution_results", "sa_constitution_questions",
        "sa_solar_term_contents",
        "sa_content_media", "sa_content_tag_relations",
        "sa_membership_benefit_usage", "sa_user_memberships",
        "sa_reminder_logs",
        # 原生 sqlite3 表
        "journal_entries", "checkin_streaks", "wellness_insights",
        "sleep_records", "emotion_records", "care_status",
        "tea_reviews", "user_favorite_teas", "user_tea_logs",
        "skills", "skill_executions", "user_skills",
        "contents", "content_reviews", "content_bookmarks",
        "subscriptions", "payments",
        "habits", "habit_logs",
        "memories", "followups",
        "settings", "notifications",
        "solar_term_schedules", "solar_term_wisdom",
        "recipes", "recipe_reviews",
        "coupons", "memberships",
        "chat_sessions", "chat_messages",
        "exercise_records", "exercise_plans",
        "gratitude_entries", "water_logs",
        "baduanjin_records", "calorie_entries",
        "family_relations", "family_invites",
    ]
    for table in tables_to_truncate:
        try:
            db.execute(f"DELETE FROM {table}")
        except Exception:
            pass  # 表可能不存在
    try:
        db.commit()
    except Exception:
        pass
    close_all_test_connections()
    yield


@pytest.fixture(scope="function")
def db_session():
    """数据库会话 fixture"""
    from app.db.database import SessionLocal
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


@pytest.fixture(scope="function")
def test_user(client):
    """注册测试用户并返回用户信息"""
    email = "test@example.com"
    password = "TestPass123!"
    resp = client.post("/api/v1/auth/register", json={
        "email": email,
        "password": password,
        "name": "测试用户",
    })
    if resp.status_code in (200, 201):
        data = resp.json()
        return {"email": email, "password": password, "name": "测试用户", **data.get("data", {}).get("user", {})}
    else:
        # 尝试登录（可能已注册）
        resp = client.post("/api/v1/auth/login", json={
            "email": email,
            "password": password,
        })
        data = resp.json()
        return {"email": email, "password": password, "name": "测试用户", **data.get("data", {}).get("user", {})}


@pytest.fixture(scope="function")
def test_user_token(client, test_user):
    """注册测试用户并返回 JWT token"""
    resp = client.post("/api/v1/auth/login", json={
        "email": test_user["email"],
        "password": test_user["password"],
    })
    data = resp.json()
    token = data.get("access_token") or data.get("token", "")
    return token


@pytest.fixture(scope="function")
def auth_headers(test_user_token):
    """带 Bearer token 的请求头"""
    return {"Authorization": f"Bearer {test_user_token}"}
