# ====================================
# 顺时 ShunShi - 环境变量模板 (.env.example)
# 复制为 .env 并填写实际值
# ====================================

# ==================== 通用 ====================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=4000
# ⚠️ 生产环境必须设置为强随机字符串（建议 openssl rand -hex 32）
APP_SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ==================== 数据库 ====================
# 开发环境: 留空使用 SQLite (data/shunshi.db)
# 生产环境: 填写 PostgreSQL URL
DATABASE_URL=
# 生产环境示例: DATABASE_URL=postgresql+psycopg2://user:password@host:5432/shunshi
# Docker: DATABASE_URL=postgresql+psycopg2://shunshi:${DB_PASSWORD}@postgres:5432/shunshi

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
# Docker: REDIS_URL=redis://redis:6379/0

# ==================== LLM ====================
SILICONFLOW_API_KEY=sk-xxx
OPENROUTER_API_KEY=

# ==================== 支付宝 (CN版) ====================
ALIPAY_MODE=mock
# mock: 模拟模式 (开发/测试)
# sandbox: 沙箱环境
# production: 生产环境
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.shunshi.cn/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://app.shunshi.cn/payment/success

# ==================== Stripe (GL版/国际版) ====================
STRIPE_MODE=mock
# mock: 模拟模式
# test: Stripe 测试模式
# live: Stripe 生产模式
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SERENITY=
STRIPE_PRICE_HARMONY=
STRIPE_PRICE_FAMILY=

# ==================== FCM 推送 (Android) ====================
FCM_MODE=mock
# mock: 模拟模式
# production: 真实推送
FCM_PROJECT_ID=shunshi-push
FCM_CREDENTIALS_PATH=
# 或者直接 JSON 字符串:
# FCM_CREDENTIALS_JSON={"type":"service_account","project_id":"shunshi-push",...}

# ==================== APNs 推送 (iOS) ====================
APNS_MODE=mock
# mock: 模拟模式
# production: 真实推送
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=care.seasons.shunshi
APNS_USE_SANDBOX=true
APNS_QUIET_START=22:00
APNS_QUIET_END=07:00

# ==================== 统一通知网关 ====================
NOTIFICATION_MODE=mock

# ==================== 监控 ====================
METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
# ⚠️ 生产环境必须修改默认密码
GRAFANA_ADMIN_PASSWORD=

# ==================== CORS ====================
CORS_ORIGINS=https://app.shunshi.cn,https://app.seasons.care

# ==================== Apple Sign-In ====================
APPLE_BUNDLE_ID=com.shunshi.app
APPLE_TEAM_ID=
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# 苹果 IAP 服务端验证密钥 (App Store Server Notifications)
APPLE_SHARED_SECRET=

# ==================== Google Play (Android 订阅验证) ====================
GOOGLE_PACKAGE_NAME=care.seasons.android
# Google Play 服务账号 JSON (两种方式二选一):
GOOGLE_SERVICE_ACCOUNT_JSON=
# 或者指定本地文件路径:
# GOOGLE_SERVICE_ACCOUNT_PATH=secrets/google-service-account.json

# ==================== 告警系统 ====================
ALERT_ENABLED=false
# Webhook 告警 (支持 Feishu / DingTalk / Slack 通用格式)
ALERT_WEBHOOK_URL=
# 微信企业机器人 Webhook
ALERT_WECHAT_WEBHOOK_URL=

# ==================== OpenRouter ====================
# 备用 LLM 网关 (用于 Claude / GPT fallback)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# ==================== 限流配置 (Rate Limiting) ====================
# 是否启用限流（false = 关闭，适合开发环境）
RATE_LIMIT_ENABLED=true
# 普通接口：每分钟最多请求次数
RATE_LIMIT_DEFAULT_RPM=60
# AI / LLM 接口：每分钟最多请求次数
RATE_LIMIT_AI_RPM=20
# 上传接口：每分钟最多请求次数
RATE_LIMIT_UPLOAD_RPM=10
EMBEDDING_PROVIDER=local  # siliconflow | openai | local
