# 顺时后端环境变量样例（全部为占位值，部署时替换；勿提交真实密钥）

# development / test / production
SHUNSHI_ENV=development

# 数据库：开发可缺省用 SQLite；生产用 PostgreSQL
# SHUNSHI_DATABASE_URL=sqlite:///./shunshi_dev.db
# SHUNSHI_DATABASE_URL=postgresql+psycopg://shunshi:CHANGE_ME@postgres:5432/shunshi

# 产品模型（体质、日记、社区…）默认与上面同库、放在独立 schema shunshi_product。
# 两套模型都有 users 表且列不同，所以不能放在同一个 schema。需要分库时显式给：
# SHUNSHI_PRODUCT_DATABASE_URL=postgresql+psycopg://shunshi:CHANGE_ME@postgres:5432/shunshi_product

# 知识库文稿目录（compose 已把仓库根上的「参考文档，知识库」只读挂到这里）
# SHUNSHI_KNOWLEDGE_DIR=/app/knowledge

# 管理后台（必填，缺失时后端启动即失败）
# ADMIN_PASSWORD_HASH=<echo -n '管理员口令' | sha256sum 的结果>
# ADMIN_JWT_SECRET=CHANGE_ME_at_least_32_chars

# Redis（健康检查组件；未配置时 /api/health 中 redis 项 down）
# SHUNSHI_REDIS_URL=redis://redis:6379/0

# JWT 密钥：生产必须 >= 32 位随机串；未配置时认证接口 fail-closed 503。
# 登录接口与其他接口共用这一把。旧名 JWT_SECRET 不要再配；两者不一致时拒绝启动。
# SHUNSHI_JWT_SECRET=CHANGE_ME_at_least_32_chars

# 模型网关基址：未配置时 /api/v1/chat* fail-closed 503
# SHUNSHI_MODEL_ROUTER_URL=http://model-router:8020

# 短信服务商：未配置时 /api/v1/auth/sms/* fail-closed 503
# SHUNSHI_SMS_PROVIDER_URL=https://sms-provider.example/send
# SHUNSHI_SMS_PROVIDER_TOKEN=CHANGE_ME

# 支付回调验签密钥：未配置时 /api/v1/billing/callback fail-closed 503
# SHUNSHI_PAYMENT_CALLBACK_SECRET=CHANGE_ME

# 支付宝（PEM 可将换行写成 \n；生产环境必须使用正式应用与支付宝公钥）
# ALIPAY_MODE=production
# ALIPAY_APP_ID=CHANGE_ME
# ALIPAY_SELLER_ID=CHANGE_ME
# ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----
# ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----
# ALIPAY_NOTIFY_URL=https://api.shunshi.example/api/v1/payments/alipay/notify
# ALIPAY_RETURN_URL=https://app.shunshi.example/payment/success

# 微信支付 API v3（商户私钥与平台公钥 PEM 同样可使用 \n）
# WECHAT_PAY_MCH_ID=CHANGE_ME
# WECHAT_PAY_APP_ID=CHANGE_ME
# WECHAT_PAY_SERIAL_NO=CHANGE_ME
# WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----
# WECHAT_PAY_API_V3_KEY=CHANGE_ME_EXACTLY_32_BYTES_LONG
# WECHAT_PAY_NOTIFY_URL=https://api.shunshi.example/api/v1/payments/wechat/notify
# WECHAT_PAY_PLATFORM_SERIAL_NO=CHANGE_ME
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----

# 内容源（CMS/音频）基址：未配置时 /api/v1/contents*、/api/v1/cms/*、/api/v1/seasons/audio/{id} fail-closed 503
# SHUNSHI_CONTENT_SOURCE_URL=http://content-service:8030

# 生产 CORS 白名单（逗号分隔）
# SHUNSHI_CORS_ORIGINS=https://shunshi.example
