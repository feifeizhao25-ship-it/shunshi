# 顺时 —— docker-compose.yml 读取的根目录环境变量样例
#
#     cp .env.example .env     # 本文件：compose 自己要用的变量
#     cp backend/.env.example backend/.env   # 后端进程要用的变量
#
# 两个文件是分开的，**都要**：
#   · 本文件给 compose 展开 ${...}（数据库口令、Redis 口令、Grafana 口令…）
#   · backend/.env 给后端进程（SHUNSHI_JWT_SECRET、支付密钥…）
#
# 此前仓库里只有 backend/.env.example，compose 头部也只写了 cp 那一个，
# 于是这里的变量全部为空——postgres 起不来、Grafana 回落到 admin/admin。
#
# ⚠️ 真实口令不要提交。生成方法：openssl rand -base64 32

# ── 数据库 ─────────────────────────────────────────────────────
DB_NAME=shunshi
DB_USER=shunshi
DB_PASSWORD=
# 宿主机上映射的端口（只绑 127.0.0.1，外网连接请走 SSH 隧道）
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
# 必填。为空时 compose 直接拒绝启动——开放且无口令的 Redis
# 是一条可以直接拿到宿主机的路径。
REDIS_PASSWORD=

# ── 监控面板 ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# 必填。为空时 Grafana 会回落到内置的 admin/admin。
GRAFANA_ADMIN_PASSWORD=

# ── 前端构建参数 ───────────────────────────────────────────────
# 国内 Web/PWA 打包时写死的 API 源站，必须与实际对外域名一致
CN_API_ORIGIN=https://api.shunshi.example

# ── 对外站点（nginx）────────────────────────────────────────────
# 本地/内网：留空，使用 docker/nginx/conf.d/default.conf（HTTP）。
# 生产：设为 shunshi-ssl.conf，并填好下面三个已备案域名；证书放 backend/docker/ssl/。
# 上线前运行 python3 scripts/check_nginx_site.py 检查。
SHUNSHI_NGINX_SITE=
SHUNSHI_WEB_DOMAIN=
SHUNSHI_API_DOMAIN=
SHUNSHI_ADMIN_DOMAIN=
# 注意：上面的 CN_API_ORIGIN 必须等于 https://<SHUNSHI_API_DOMAIN>；
# App（android-cn / ios-cn）打包时也要用同一个地址：--dart-define=API_BASE_URL=https://<SHUNSHI_API_DOMAIN>
# （不传时客户端默认连 https://api.shunshi.app——请确认这是你们持有并已备案的域名）。
